# Multi-stage prod build for @repo/web (TanStack Start SSR).
FROM node:24-slim AS base
RUN corepack enable
WORKDIR /app

FROM base AS pruner
COPY . .
RUN pnpm dlx turbo@^2.5.0 prune @repo/web --docker

FROM base AS builder
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
# Builds the vite client + SSR bundle and the prod Node server (tsup).
RUN pnpm --filter @repo/web build

FROM base AS runner
ENV NODE_ENV=production
COPY --from=builder /app .
WORKDIR /app/apps/web
EXPOSE 3000
CMD ["node", "--import", "./dist/instrument.js", "dist/server.prod.js"]
