# Multi-stage prod build for @repo/api using turbo prune for a lean context.
FROM node:24-slim AS base
RUN corepack enable
WORKDIR /app

# 1. Prune the workspace to just @repo/api and its deps.
FROM base AS pruner
COPY . .
RUN pnpm dlx turbo@^2.5.0 prune @repo/api --docker

# 2. Install deps (from pruned json) and build.
FROM base AS builder
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
RUN pnpm --filter @repo/api build

# 3. Runtime image.
FROM base AS runner
ENV NODE_ENV=production
COPY --from=builder /app .
WORKDIR /app/apps/api
EXPOSE 3001
CMD ["node", "--import", "./dist/instrument.js", "dist/index.js"]
