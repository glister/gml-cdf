{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "PORT",
    "PORT_WEB",
    "PORT_API",
    "PORT_WORKER",
    "PORT_MAILPIT_SMTP",
    "PORT_MAILPIT_UI",
    "PORT_SERVICEBUS",
    "PORT_AZURITE",
    "PORT_GOTENBERG",
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "POSTGRES_HOST",
    "POSTGRES_DB",
    "POSTGRES_PORT",
    "POSTGRES_SSL",
    "DATABASE_URL",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "ENTRA_TENANT_ID",
    "ENTRA_CLIENT_ID",
    "ENTRA_CLIENT_SECRET",
    "TURNSTILE_SECRET_KEY",
    "VITE_TURNSTILE_SITE_KEY",
    "APP_URL",
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "EMAIL_SMTP_HOST",
    "EMAIL_SMTP_PORT",
    "SERVICE_BUS_CONNECTION_STRING",
    "AZURE_STORAGE_CONNECTION_STRING",
    "AZURE_STORAGE_CONTAINER",
    "HYPERDX_API_KEY",
    "OTEL_SERVICE_NAME",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "API_INTERNAL_URL",
    "VITE_API_URL",
    "EXPO_PUBLIC_API_URL",
    "GOTENBERG_URL",
    "GRAPH_TENANT_ID",
    "GRAPH_CLIENT_ID",
    "GRAPH_CLIENT_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
