      "platform.person.profile_status": "Generated<'draft_shell' | 'information_requested' | 'information_submitted' | 'pending_review' | 'incomplete_rejected' | 'approved_not_active' | 'active' | 'active_with_restrictions' | 'inactive' | 'leaver' | 'reactivated'>",
