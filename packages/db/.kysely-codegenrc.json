      "platform.role_grant.module": "'platform' | 'hr.core' | 'hr.onboarding' | 'hr.holiday_leave' | 'hr.sickness_absence' | 'hr.er' | 'hr.ld' | 'hr.offboarding' | 'hr.wellbeing' | 'hr.reporting'",
