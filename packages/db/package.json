{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migration-helpers": "./src/migration-helpers.ts",
    "./test-support": "./src/test-support.ts"
  },
  "scripts": {
    "migrate": "tsx --env-file ../../.env src/migrate.ts",
    "migrate:ci": "tsx src/migrate.ts",
    "migrate:generate": "pnpm migrate && kysely-codegen --env-file ../../.env --out-file src/types.ts --exclude-pattern 'kysely_*' --date-parser string",
    "seed": "tsx --env-file ../../.env src/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@repo/domain": "workspace:*",
    "@repo/env": "workspace:*",
    "better-auth": "^1.5.0",
    "kysely": "^0.29.0",
    "pg": "^8.13.0",
    "uuid": "^11.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.0",
    "eslint": "^9.22.0",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.0"
  }
}
