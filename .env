# Committed non-secret dev config. NEVER put real secrets here — those live in
# .env.secrets (git-ignored). Host-run commands (pnpm migrate/seed/worker trigger)
# read this file; the compose `dev` service overrides *_HOST values to the
# in-network service names (postgres, azurite, servicebus-emulator, mailpit).

# --- Ports (web 3000 / api 3001 / worker 3002) ---
PORT_WEB=3000
PORT_API=3001
PORT_WORKER=3002

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_DB=cdf_dev
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cdf_dev

# --- Better Auth ---
BETTER_AUTH_URL=http://localhost:3001
APP_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Email (local: Mailpit SMTP catcher) ---
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_FROM=noreply@cdf.local

# --- Azure emulators ---
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONTAINER=uploads
# Backing SQL password for the Service Bus emulator (compose-only, not app config).
MSSQL_SA_PASSWORD=Str0ng!Passw0rd

# --- Observability ---
LOG_LEVEL=info
NODE_ENV=development

# --- Web / client ---
VITE_API_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001
# Prod web Node server port (server.prod.ts). Locally the web app runs on vite (3000).
PORT=3000
