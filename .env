# Committed non-secret dev config. NEVER put real secrets here — those live in
# .env.secrets (git-ignored). Host-run commands (pnpm migrate/seed/worker trigger)
# read this file; the compose `dev` service overrides *_HOST values to the
# in-network service names (postgres, azurite, servicebus-emulator, mailpit).

# --- Ports (derived from package.json "portPrefix", or a local .portPrefix
#     override, via `pnpm ports:sync`) ---
# Docker compose project name. Derived alongside the ports so a worktree running
# an overridden prefix owns a separate stack instead of driving this one's
# containers and volumes. Outranks the top-level `name:` in compose.yml.
COMPOSE_PROJECT_NAME=cdf
PORT_WEB=17000
PORT_API=17001
PORT_WORKER=17002

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_DB=cdf_dev
POSTGRES_PORT=17010
# TLS to Postgres. Off locally (loopback, plaintext container); 'true' in every
# Azure environment, where Flexible Server refuses unencrypted connections.
POSTGRES_SSL=false
DATABASE_URL=postgres://postgres:postgres@localhost:17010/cdf_dev

# --- Better Auth ---
BETTER_AUTH_URL=http://localhost:17001
APP_URL=http://localhost:17000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:17000,http://localhost:17001

# --- Identity: Entra ID (employee SSO) — non-secret ids (plan 03, PL-032) ---
# The Microsoft provider ships inert until ENTRA_CLIENT_SECRET is set in
# .env.secrets (CDF IT app registration; open question Q1). Placeholders here.
ENTRA_TENANT_ID=common
ENTRA_CLIENT_ID=

# --- Identity: Cloudflare Turnstile (bot protection on OTP send, PL-044) ---
# The captcha plugin ships inert until TURNSTILE_SECRET_KEY is set in
# .env.secrets. VITE_TURNSTILE_SITE_KEY is the public client key. The value
# below is Cloudflare's public "always passes, visible widget" TEST site key so
# the widget renders in dev; swap for the real CDF site key in production.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- Email (local: Mailpit SMTP catcher) ---
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=17020
EMAIL_FROM=noreply@cdf.local
PORT_MAILPIT_SMTP=17020
PORT_MAILPIT_UI=17021

# --- Document rendering: Gotenberg (HTML -> PDF, core plan 11 §4.6/Q1) ---
# Host-published port is for poking the service by hand; the worker reaches it
# in-network on the container's fixed 3000. GOTENBERG_URL is therefore an
# INTERNAL address — it is read server-side only, never by a browser.
PORT_GOTENBERG=17024
GOTENBERG_URL=http://localhost:17024

# --- Microsoft Graph / SharePoint (core plan 11 §6, ADR-0017) — non-secret ids
# The SharePoint adapter ships INERT until GRAPH_CLIENT_SECRET is set in
# .env.secrets (CDF IT app registration + Sites.Selected consent; §12.2 Q4).
# Until then filing stays `pending` and documents are served from staged bytes,
# which is the degradation the two-phase issue design exists to provide.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=

# --- Azure emulators ---
# Host-published ports (compose maps these to the fixed container ports 5672/10000).
PORT_SERVICEBUS=17012
PORT_AZURITE=17013
# Explicit host ports so host-run tools connect on the prefixed ports. The compose
# `dev` service overrides both to the in-network names (servicebus-emulator/azurite).
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://localhost:17012;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:17013/devstoreaccount1;
AZURE_STORAGE_CONTAINER=uploads
# Backing SQL password for the Service Bus emulator (compose-only, not app config).
MSSQL_SA_PASSWORD=Str0ng!Passw0rd

# --- Observability ---
LOG_LEVEL=info
NODE_ENV=development

# --- Web / client ---
VITE_API_URL=http://localhost:17001
API_INTERNAL_URL=http://localhost:3001
# Prod web Node server port (server.prod.ts). Locally the web app runs on vite (3000).
PORT=3000
