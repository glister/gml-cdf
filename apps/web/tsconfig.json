{
  "extends": "@repo/typescript-config/react.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "tsup.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["dist", "node_modules", ".output"]
}
