{
  "name": "@repo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include '../../packages/**/*.ts' --conditions=development --import ./src/instrument.ts src/index.ts",
    "trigger": "tsx --env-file ../../.env scripts/publish.ts",
    "sweeps": "tsx --env-file ../../.env src/publish-sweeps.ts",
    "build": "tsup",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "scheduler": "tsx --env-file ../../.env src/scheduler.ts"
  },
  "dependencies": {
    "@azure/service-bus": "^7.9.5",
    "@repo/config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/email": "workspace:*",
    "@repo/env": "workspace:*",
    "@repo/identity": "workspace:*",
    "@repo/logging": "workspace:*",
    "@repo/service-bus": "workspace:*",
    "@repo/trpc": "workspace:*",
    "@repo/workflow": "workspace:*",
    "csv-parse": "^5.6.0",
    "kysely": "^0.29.0",
    "winston": "^3.19.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.0"
  }
}
