# Copy to .env.secrets (git-ignored) and fill in real values.
# Loaded into the dev container via compose `env_file`.

# Resend API key (prod email). Locally email goes to Mailpit, so any value works.
RESEND_API_KEY=

# Better Auth signing secret. Generate: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Shared secret for service-to-service tRPC calls (x-service-token).
INTERNAL_SERVICE_TOKEN=
