# Committed test-safe defaults. vitest-config/setup-env.ts loads this (only for
# keys not already set), so Zod env validation passes in CI and locally.
# WHENEVER a new env var is added anywhere, add a test-safe default here.

# --- Ports ---
PORT_WEB=3000
PORT_API=3001
PORT_WORKER=3002

# --- Postgres (separate test DB / port) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_DB=cdf_test
POSTGRES_PORT=5433
DATABASE_URL=postgres://postgres:postgres@localhost:5433/cdf_test

# --- Better Auth ---
BETTER_AUTH_URL=http://localhost:3001
APP_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
BETTER_AUTH_SECRET=test-better-auth-secret-do-not-use-in-prod

# --- Internal service auth ---
INTERNAL_SERVICE_TOKEN=test-internal-service-token

# --- Email ---
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_FROM=noreply@cdf.local
RESEND_API_KEY=test

# --- Azure emulators ---
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONTAINER=uploads

# --- Observability ---
LOG_LEVEL=error
NODE_ENV=test

# --- Web / client ---
VITE_API_URL=http://localhost:3001

# --- Mobile / client (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001
PORT=3000
