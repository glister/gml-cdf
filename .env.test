# Committed test-safe defaults. vitest-config/setup-env.ts loads this (only for
# keys not already set), so Zod env validation passes in CI and locally.
# WHENEVER a new env var is added anywhere, add a test-safe default here.

# --- Ports ---
PORT_WEB=17000
PORT_API=17001
PORT_WORKER=17002

# --- Postgres (separate test DB / port) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_DB=cdf_test
POSTGRES_PORT=17010
# Off: the CI/dev Postgres container speaks plaintext.
POSTGRES_SSL=false
DATABASE_URL=postgres://postgres:postgres@localhost:17010/cdf_test

# --- Better Auth ---
BETTER_AUTH_URL=http://localhost:17001
APP_URL=http://localhost:17000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:17000,http://localhost:17001
BETTER_AUTH_SECRET=test-better-auth-secret-do-not-use-in-prod

# --- Identity: Entra ID + Turnstile (plan 03) — test-safe placeholders ---
# All optional in the auth env schema; present here so parse() is exercised and
# suites stay deterministic. The providers are gated on presence at runtime.
ENTRA_TENANT_ID=test-tenant
ENTRA_CLIENT_ID=test-entra-client
ENTRA_CLIENT_SECRET=test-entra-secret-do-not-use
TURNSTILE_SECRET_KEY=test-turnstile-secret-do-not-use
VITE_TURNSTILE_SITE_KEY=test-turnstile-site-key

# --- Email ---
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=17020
EMAIL_FROM=noreply@cdf.local
RESEND_API_KEY=test

# --- Azure emulators (shared dev containers; explicit host ports) ---
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://localhost:17012;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:17013/devstoreaccount1;
AZURE_STORAGE_CONTAINER=uploads

# --- Observability ---
LOG_LEVEL=error
NODE_ENV=test

# --- Web / client ---
VITE_API_URL=http://localhost:17001

# --- Mobile / client (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:17001
API_INTERNAL_URL=http://localhost:3001
PORT=3000
